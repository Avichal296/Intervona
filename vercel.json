{
    "services": {
      "frontend": {
        "root": "apps/frontend"
      },
      "backend": {
        "root": "apps/backend"
      }
    },
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": {
          "service": "backend"
        }
      },
      {
        "source": "/(.*)",
        "destination": {
          "service": "frontend"
        }
      }
    ]
  }