{
  "name": "intervona",
  "private": true,
  "packageManager": "npm@10.9.8",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.23",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.7",
    "typescript": "5.9"
  },
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "react-router": "^8.3.0"
  }
}
